<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BookDB.Desktop.ViewModels"
             xmlns:res="using:BookDB.Desktop.Localization"
             x:Class="BookDB.Desktop.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">

  <Grid Margin="8" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

    <TextBlock Grid.Row="0"
               Text="{x:Static res:Resources.Devices_Intro}"
               FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,4"/>

    <TextBlock Grid.Row="1"
               Text="{Binding CountText}"
               FontSize="12" Opacity="0.6" Margin="0,0,0,12"/>

    <Border Grid.Row="2"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4">
      <Grid>
        <TextBlock Text="{x:Static res:Resources.Devices_None}"
                   IsVisible="{Binding HasNoDevices}"
                   FontSize="12" Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <DataGrid ItemsSource="{Binding Devices}"
                  IsVisible="{Binding !HasNoDevices}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static res:Resources.Devices_Column_Name}"
                                Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="{x:Static res:Resources.Devices_Column_Paired}"
                                Binding="{Binding PairedAt}" Width="Auto"/>
            <DataGridTextColumn Header="{x:Static res:Resources.Devices_Column_LastUsed}"
                                Binding="{Binding LastUsed}" Width="Auto"/>
            <DataGridTemplateColumn Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PairedDeviceRow">
                  <Button Content="{x:Static res:Resources.Devices_Remove}"
                          Margin="4,2"
                          Command="{Binding $parent[DataGrid].((vm:DevicesViewModel)DataContext).RemoveCommand}"
                          CommandParameter="{Binding}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <TextBlock Grid.Row="3"
               Text="{x:Static res:Resources.Devices_CompanionOff}"
               IsVisible="{Binding IsCompanionOff}"
               FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,12,0,0"/>

    <TextBlock Grid.Row="4"
               Text="{Binding AtLimitText}"
               IsVisible="{Binding IsAtDeviceLimit}"
               FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,12,0,0"/>

    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Classes="accent"
              Content="{x:Static res:Resources.Devices_ShowPairingCode}"
              Command="{Binding ShowPairingCodeCommand}"
              IsEnabled="{Binding CanPair}"/>
      <Button Classes="helpLink" VerticalAlignment="Center"
              Command="{Binding OpenCompanionHelpCommand}">
        <TextBlock Text="{x:Static res:Resources.Help_CompanionLink}" TextDecorations="Underline"/>
      </Button>
    </StackPanel>
  </Grid>

</UserControl>
