<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 so the desktop host and every mobile head (Android now, iOS later) reference the
         same contract assembly. The SDK defaults netstandard2.0 to C# 7.3, which predates nullable
         reference types, so the language version has to be pinned forward. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="protobuf-net.Grpc" />
    <PackageReference Include="System.Text.Json" />
    <!-- Not used by this code. protobuf-net pulls the WCF service-model primitives onto netstandard2.0,
         and those ask for System.Text.RegularExpressions 4.3.0 — a high-severity ReDoS
         (GHSA-cmhx-cq75-c4mj). Naming it here lifts the whole graph to the patched 4.3.1. -->
    <PackageReference Include="System.Text.RegularExpressions" />
  </ItemGroup>

</Project>
