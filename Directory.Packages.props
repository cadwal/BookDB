<Project>

  <!-- Central Package Management: every NuGet version is declared once here, and PackageReference items in the
       .csproj files carry no Version. This keeps versions from drifting between projects. See
       https://learn.microsoft.com/nuget/consume-packages/central-package-management. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Avalonia &amp; UI">
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <!-- The DataGrid patches on its own cadence and can run ahead of the core version. -->
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- Must track the core Avalonia version. The Android head is outside BookDB.slnx, so the update check
         does not see it — bump this whenever Avalonia moves. -->
    <PackageVersion Include="Avalonia.Android" Version="12.1.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
    <!-- The ISBN camera: CameraX for the preview and frame stream, ML Kit for the decode. The bundled
         BarcodeScanning model (~3 MB) is deliberate — it needs no Play services and no first-use download,
         so scanning works on any device and offline from the first launch. -->
    <PackageVersion Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.View" Version="1.6.1.1" />
    <PackageVersion Include="Xamarin.Google.MLKit.BarcodeScanning" Version="117.3.0.8" />
    <!-- Cover capture: ML Kit's document scanner brings its own camera UI and returns a perspective-corrected
         crop. Unlike the barcode model it is delivered on demand by Play services, so the app probes for
         those first (Base) and tells the user when the module still has to be downloaded. -->
    <PackageVersion Include="Xamarin.GooglePlayServices.MLKit.DocumentScanner" Version="116.0.0.3" />
    <PackageVersion Include="Xamarin.GooglePlayServices.Base" Version="118.10.0.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Markdown.Avalonia.Tight" Version="12.0.0-a3" />
    <PackageVersion Include="ScottPlot.Avalonia" Version="5.1.59" />
    <PackageVersion Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.13" />
    <PackageVersion Include="Xaml.Behaviors.Interactions" Version="12.0.7" />
    <PackageVersion Include="Xaml.Behaviors.Interactivity" Version="12.0.7" />
  </ItemGroup>

  <ItemGroup Label="App / runtime">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="QuestPDF" Version="2026.8.0" />
    <PackageVersion Include="Devlooped.CredentialManager" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions / hosting">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="EF Core &amp; database providers">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Pin: unifies the SQLitePCLRaw graph via project references. The advisory it was taken out for
         (GHSA-2m69-gcr7-jv3q) is gone — EF Core asks for 2.1.12 now — so this is no longer load-bearing;
         it is kept only because it ships a newer native SQLite. Dropping it is a deliberate change to the
         native library users get, so it needs its own DB pass (see docs/dependency-maintenance.md). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="10.0.11" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="dbup-core" Version="6.1.1" />
    <PackageVersion Include="dbup-sqlite" Version="6.0.4" />
    <PackageVersion Include="dbup-postgresql" Version="7.0.1" />
    <PackageVersion Include="dbup-mysql" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup Label="Companion (mobile scanner)">
    <PackageVersion Include="protobuf-net.Grpc" Version="1.3.14" />
    <PackageVersion Include="protobuf-net.Grpc.AspNetCore" Version="1.3.14" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="Net.Codecrete.QrCodeGenerator" Version="3.1.0" />
    <!-- Matches the version Avalonia already resolves, so the desktop app ships one Skia. Newer majors
         exist; they move only when Avalonia moves. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <!-- IAsyncEnumerable on netstandard2.0; protobuf-net.Grpc pulls it transitively.
         Kept at the same patch level as the rest of the .NET 10 packages above. -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
    <!-- The pairing payload is JSON, and netstandard2.0 has no in-box System.Text.Json. -->
    <PackageVersion Include="System.Text.Json" Version="10.0.11" />
    <!-- Security pin. protobuf-net drags System.Private.ServiceModel onto netstandard2.0 for its WCF
         support, and that asks for System.Text.RegularExpressions 4.3.0 — a high-severity ReDoS
         (GHSA-cmhx-cq75-c4mj) fixed in 4.3.1. Referenced explicitly by Contracts so the graph resolves to
         the patched one. Still needed on protobuf-net.Grpc 1.3.14 / protobuf-net 2.4.8; re-check when
         protobuf-net 3.x lands, which drops the WCF primitives. -->
    <PackageVersion Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <!-- Headless UI testing. The XUnit integration provides the v3-native [AvaloniaFact]/[AvaloniaTheory];
         the base package carries the headless platform + input extensions. Both must match the Avalonia version. -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.MariaDb" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.XunitV3" Version="4.14.0" />
  </ItemGroup>

</Project>
